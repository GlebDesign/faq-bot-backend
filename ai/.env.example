# Configuration reference. The CLI reads environment variables, not this file.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set exact model tags agreed with the team; no weights are downloaded by this app.
LLM_MODEL=
EMBEDDING_MODEL=
# Bump when embedding weights/configuration change, then re-ingest documents.
EMBEDDING_REVISION=1
OLLAMA_TIMEOUT=60
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Illustrative cosine threshold; calibrate on independent evaluation data.
MIN_SCORE=0.5
CONTEXT_CHARS=6000
