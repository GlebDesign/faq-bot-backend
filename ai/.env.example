# Configuration reference. The CLI reads environment variables, not this file.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set exact model tags agreed with the team; no weights are downloaded by this app.
LLM_MODEL=
EMBEDDING_MODEL=
# Bump when embedding weights/configuration change, then re-ingest documents.
EMBEDDING_REVISION=1
OLLAMA_TIMEOUT=60
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Illustrative cosine threshold; calibrate on independent evaluation data.
MIN_SCORE=0.5
CONTEXT_CHARS=6000
LLM_CONTEXT_TOKENS=8192
LLM_MAX_TOKENS=1400
# Optional CPU/RAM controls. Leave unset to use runtime defaults.
# MODEL_THREADS=4
# MODEL_KEEP_ALIVE=0
# LLM_THINKING=false
LLM_TEMPERATURE=0
# LLM_TOP_P=0.8
# LLM_TOP_K=20
# LLM_REPEAT_PENALTY=1.1
# LLM_SEED=42
# QUOTE_ONLY_ANSWERS=true

# Separate gRPC/worker configuration. See docs/AI_INTEGRATION.md for provisioning.
# AI_DATABASE_URL=postgresql://AI_RUNTIME_USER:PASSWORD@127.0.0.1:55432/faq_ai18
# AI_AMQP_URL=amqp://WORKER_USER:PASSWORD@127.0.0.1:55672/ai18
# AI_SERVICE_TOKEN=GENERATE_A_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# AI_SOURCE_ROOT=C:/path/to/read-only-sources
# AI_GRPC_LISTEN=127.0.0.1:50051
# AI_BACKEND=ollama
# AI_EMBEDDING_DIMENSION=1024
# AI_EMBEDDING_DIGEST=PIN_THE_OLLAMA_MODEL_DIGEST
# AI_GENERATION_DIGEST=PIN_THE_OLLAMA_MODEL_DIGEST
# AI_EMBEDDING_BATCH=16
# AI_CONCURRENCY=1
# AI_QUEUE_SIZE=2
# AI_LEASE_SECONDS=300
# AI_MAX_ATTEMPTS=3
# AI_RETRY_SECONDS=5
# AI_PARSE_TIMEOUT=20
# AI_PREFETCH=1
