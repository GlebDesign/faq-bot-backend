# Configuration reference. The CLI reads environment variables, not this file.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set exact model tags agreed with the team; no weights are downloaded by this app.
LLM_MODEL=
EMBEDDING_MODEL=
# Bump when embedding weights/configuration change, then re-ingest documents.
EMBEDDING_REVISION=1
OLLAMA_TIMEOUT=60
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Illustrative cosine threshold; calibrate on independent evaluation data.
MIN_SCORE=0.5
CONTEXT_CHARS=6000
LLM_CONTEXT_TOKENS=8192
LLM_MAX_TOKENS=1400
# Optional CPU/RAM controls. Leave unset to use runtime defaults.
# MODEL_THREADS=4
# MODEL_KEEP_ALIVE=0
# LLM_THINKING=false
LLM_TEMPERATURE=0
# LLM_TOP_P=0.8
# LLM_TOP_K=20
# LLM_REPEAT_PENALTY=1.1
# LLM_SEED=42
# Independent embedding adapter controls; no backend/queue settings.
# EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
MODEL_CONCURRENCY=1
