# Defaults for local development. The process reads environment variables;
# this file is not loaded automatically.
APP_ENV=development
HTTP_LISTEN_ADDR=127.0.0.1:8080
HTTP_SHUTDOWN_TIMEOUT=10s

# Set DATABASE_URL separately via environment or secret store; required in
# staging/production and for cmd/migrate. No credentials belong in this file.
MIGRATIONS_PATH=./migrations
