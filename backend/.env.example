# Значения для локальной разработки. Программа читает переменные окружения;
# этот файл не загружается автоматически.
APP_ENV=development
HTTP_LISTEN_ADDR=127.0.0.1:8080
HTTP_SHUTDOWN_TIMEOUT=10s

# DATABASE_URL задаётся отдельно через окружение или хранилище секретов.
# Обязателен для staging/production и cmd/migrate. Секреты сюда не добавляются.
MIGRATIONS_PATH=./migrations

# Любая Auth-переменная включает проверку полного набора настроек и требует БД.
# Для стенда нужен HTTPS. Без Auth разрешён только режим development.
# SUPABASE_URL=https://project.supabase.co
# SUPABASE_KEY задаётся отдельно через окружение или хранилище секретов.
# AUTH_ORIGIN=https://faq.example.org
# HTTP разрешён только в development для loopback-адреса клиента или провайдера.
# AUTH_ALLOW_INSECURE_HTTP=true
