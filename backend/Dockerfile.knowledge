FROM golang:1.24-bookworm AS build
WORKDIR /build
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /knowledge-worker ./cmd/knowledge-worker

FROM debian:bookworm-slim
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /knowledge-worker /usr/local/bin/knowledge-worker
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/knowledge-worker"]
